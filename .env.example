# ---- Server ----
PORT=4000
# Comma separated list, or * for any origin (Flutter web / admin)
ALLOWED_ORIGINS=*

# ---- AWS (DynamoDB) ----
AWS_REGION=ap-south-1
# Leave these two empty when running on AWS with an IAM role (App Runner / EC2 / Lambda)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Table names (defaults shown). Create them with: npm run create-tables
DYNAMODB_COMPANIES_TABLE=SC_Companies
DYNAMODB_USERS_TABLE=SC_Users
DYNAMODB_SHOPS_TABLE=SC_Shops
DYNAMODB_CALLLOGS_TABLE=SC_CallLogs

# ---- Firebase (Auth only) ----
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# then: base64 -w0 serviceAccount.json   and paste the result here
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Salesmen log in with their mobile number. Internally Firebase needs an email,
# so each salesman gets  <mobile>@<SALESMAN_EMAIL_DOMAIN>.  Must match the
# value in the Flutter app (lib/core/constants/app_constants.dart).
SALESMAN_EMAIL_DOMAIN=salesman.shopcaller.app
